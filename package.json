{
  "name": "@usions/world-engine",
  "version": "1.0.0",
  "description": "Usion World Engine — a deterministic 3D world core (city, vehicles, weapons, hazards) that runs as the server authority and as client-side prediction, for shared 100-200 player worlds on the Usion platform.",
  "type": "module",
  "private": true,
  "main": "src/core/index.js",
  "exports": {
    ".": "./src/core/index.js",
    "./core": "./src/core/index.js",
    "./modes": "./src/modes/index.js",
    "./worlds": "./src/worlds/index.js",
    "./server": "./src/server/index.js",
    "./client": "./src/client/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dimforge/rapier3d-deterministic-compat": "^0.21.0",
    "jose": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.30.1",
    "vitest": "^2.1.9"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ugshanyu/usion-world-engine.git"
  },
  "homepage": "https://github.com/ugshanyu/usion-world-engine"
}
